# shellcheck shell=bash
#
# Pinned versions for every artifact that ends up on the airgapped network.
# Change values here, re-run `make download build`, and ship the new bundle.
# Nothing downstream of scripts/01-download-artifacts.sh ever touches the internet.

# --- k3s -----------------------------------------------------------------
K3S_VERSION="v1.36.4+k3s1"
TARGET_ARCH="amd64"              # amd64 | arm64  (architecture of the bare-metal nodes)

# --- control-plane tooling baked into the installer image ----------------
HELM_VERSION="v3.21.4"
KUBECTL_VERSION="v1.36.4"

# --- Harbor --------------------------------------------------------------
HARBOR_CHART_VERSION="1.19.2"    # chart 1.19.2 == Harbor v2.15.2
HARBOR_NAMESPACE="harbor"
HARBOR_NODEPORT="30002"          # HTTP NodePort Harbor is published on
HARBOR_PROJECT="library"         # Harbor project the demo image is pushed into
# StorageClass for Harbor's four PVCs. Empty means "decide at install time":
# longhorn when it is installed, otherwise local-path. A PVC's class cannot be
# changed once it is bound, so this only takes effect on a first install.
HARBOR_STORAGE_CLASS=""

# --- Longhorn ------------------------------------------------------------
# Replicated block storage across the nodes' second disks. The image list is
# taken from the release's own deploy/longhorn-images.txt rather than from
# `helm template`: Longhorn's manager launches the engine and instance-manager
# images itself, so they never appear in a rendered manifest.
LONGHORN_VERSION="v1.12.1"
LONGHORN_CHART_VERSION="1.12.1"
LONGHORN_NAMESPACE="longhorn-system"
LONGHORN_DATA_PATH="/var/lib/longhorn"   # where the data disk is mounted
LONGHORN_REPLICA_COUNT="3"               # one replica per node
LONGHORN_FS_LABEL="longhorn"             # filesystem label on the data disk
# Make Longhorn the cluster's default StorageClass. k3s's own local-path is
# kept, but demoted, so a PVC without an explicit class gets replicated storage
# rather than a directory pinned to one node.
LONGHORN_DEFAULT_STORAGE_CLASS="true"
# Longhorn's UI has no authentication of its own. Left empty it stays on a
# ClusterIP and you reach it with `kubectl -n longhorn-system port-forward`.
# Set a port (e.g. 30004) to publish it on every node instead.
LONGHORN_UI_NODEPORT=""

# --- optional control-plane VIP (kube-vip) -------------------------------
# A floating address that lives on whichever server currently holds it, giving
# one stable IP for the API, the ingress and the registry instead of pinning
# everything to node 1.
#
# The address itself is site data, not a version, so it is prompted for (or set
# with K3S_VIP_ADDRESS / K3S_VIP_INTERFACE). Only the pins live here.
KUBE_VIP_VERSION="v1.2.3"
KUBE_VIP_IMAGE="ghcr.io/kube-vip/kube-vip"

# --- ingress -------------------------------------------------------------
# Traefik and klipper-lb already ship inside the k3s airgap bundle, so there is
# nothing extra to download. klipper-lb binds :80/:443 on every node, which is
# why the VIP answers on those ports with no load-balancer integration at all.
INGRESS_CLASS="traefik"

# --- demo workload -------------------------------------------------------
NGINX_BASE_IMAGE="nginx:1.31.5-alpine"
DEMO_IMAGE_NAME="k3s-node-demo"
DEMO_IMAGE_TAG="1.0"
DEMO_NAMESPACE="node-demo"
DEMO_NODEPORT="30080"            # NodePort the "Node N" pages are served on

# --- offline OS packages -------------------------------------------------
# An airgapped node has no apt mirror, so stage the .debs it cannot fetch:
#   policycoreutils  k3s-ansible's prereq role apt-installs it on Ubuntu
#   python3-apt      ansible.builtin.apt cannot run without it
#   open-iscsi       required by Longhorn - it attaches volumes over iSCSI
#   nfs-common       required by Longhorn for ReadWriteMany volumes
#   cryptsetup       required by Longhorn for encrypted volumes
# Add the release of every OS you deploy to; the id is "${ID}-${VERSION_ID}"
# from the node's /etc/os-release.
OFFLINE_DEB_IMAGES="debian:13 debian:12 ubuntu:26.04 ubuntu:24.04 ubuntu:22.04"
OFFLINE_DEB_PACKAGES="policycoreutils python3-apt open-iscsi nfs-common cryptsetup"

# --- installer image -----------------------------------------------------
INSTALLER_IMAGE="hardened-airgapped-k3s/installer"
INSTALLER_TAG="1.0.0"
